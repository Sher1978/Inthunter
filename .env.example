# PostgreSQL or SQLite (e.g. sqlite+aiosqlite:///./intent_hunter.db or postgresql+asyncpg://user:pass@localhost:5432/intent_hunter)
DATABASE_URL=sqlite+aiosqlite:///./intent_hunter.db

# AI Provider selection: 'auto' (Cascading Rotator), 'sambanova', 'cerebras', 'groq', 'gemini', 'openrouter'
AI_PROVIDER=auto

# 1. SambaNova Systems Cloud API Key (Free tier at https://cloud.sambanova.ai)
SAMBANOVA_API_KEY=your_sambanova_api_key_here
SAMBANOVA_API_KEYS=key1,key2
SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct

# 2. Cerebras Cloud API Key (Free tier at https://cerebras.ai)
CEREBRAS_API_KEY=csk_your_cerebras_api_key_here
CEREBRAS_API_KEYS=csk_key1,csk_key2
CEREBRAS_MODEL=llama-3.3-70b

# 3. Groq Cloud API Key Pool (Free tier at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_API_KEYS=gsk_key1,gsk_key2
GROQ_MODEL=llama-3.3-70b-versatile

# 4. Google Gemini / AI Studio API Keys (Free tier at https://aistudio.google.com)
GEMINI_API_KEY=AIzaSy_your_gemini_key
GEMINI_API_KEYS=AIzaSy_key1,AIzaSy_key2
GEMINI_MODEL=gemini-2.5-flash

# 5. OpenRouter API Key (Free tier models at https://openrouter.ai)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct:free


# Telegram Userbot credentials (my.telegram.org)
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_telegram_api_hash_here
USERBOT_SESSION_STRING=

# Telegram Alert / Partner Bot (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
ALERT_CHANNEL_ID=your_alert_channel_id_or_admin_chat_id

# Target Telegram group/channel IDs to listen to (comma-separated IDs or usernames)
TARGET_CHATS=-100123456789,test_auto_chat

# Application Config
LOG_LEVEL=INFO
MIN_MESSAGES_FOR_SCORING=2
